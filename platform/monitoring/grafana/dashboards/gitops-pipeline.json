{
  "title": "GitOps Pipeline",
  "uid": "gitops-pipeline",
  "version": 1,
  "editable": true,
  "tags": ["argocd", "gitops", "cicd"],
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "panels": [
    {
      "title": "Applications Total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "count(argocd_app_info)",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Synced Applications",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "targets": [
        {
          "expr": "count(argocd_app_info{sync_status=\"Synced\"})",
          "legendFormat": "Synced",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": {
        "colorMode": "thresholds",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Out of Sync Applications",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "count(argocd_app_info{sync_status=\"OutOfSync\"})",
          "legendFormat": "OutOfSync",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "thresholds",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Degraded Applications",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "targets": [
        {
          "expr": "count(argocd_app_health_status{health_status=\"Degraded\"})",
          "legendFormat": "Degraded",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "thresholds",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Deployment Frequency (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(argocd_app_info[24h]))",
          "legendFormat": "Deployments",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Avg Sync Duration",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "avg(argocd_app_sync_duration_seconds)",
          "legendFormat": "Avg Duration",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Change Failure Rate (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(argocd_app_sync_total{phase=\"Error|Failed\"}[24h])) / sum(increase(argocd_app_sync_total[24h])) * 100",
          "legendFormat": "CFR %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "thresholds",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Lead Time for Changes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "targets": [
        {
          "expr": "avg(argocd_app_created_timestamp_seconds - argocd_app_created_timestamp_seconds offset 1w)",
          "legendFormat": "Lead Time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Sync Status Overview",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "count(argocd_app_info) by (sync_status)",
          "legendFormat": "{{ sync_status }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      }
    },
    {
      "title": "Application Health Status",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "targets": [
        {
          "expr": "count(argocd_app_health_status) by (health_status)",
          "legendFormat": "{{ health_status }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      }
    },
    {
      "title": "Sync Duration by Application",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "targets": [
        {
          "expr": "argocd_app_sync_duration_seconds",
          "legendFormat": "{{ name }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Deployment Frequency Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(argocd_app_sync_total[24h])) by (name)",
          "legendFormat": "{{ name }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "cps" }
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Sync Results Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(argocd_app_sync_total{phase=\"Succeeded\"}[5m])) by (name)",
          "legendFormat": "Success - {{ name }}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(argocd_app_sync_total{phase=~\"Error|Failed\"}[5m])) by (name)",
          "legendFormat": "Failed - {{ name }}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "cps" }
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Time to Restore Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "time() - argocd_app_health_status{health_status!=\"Degraded\"} offset 1h",
          "legendFormat": "{{ name }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Application Details",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "argocd_app_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": {
              "name": "Application",
              "namespace": "Namespace",
              "repo": "Repository",
              "sync_status": "Sync Status",
              "health_status": "Health Status",
              "destination_cluster": "Destination Cluster",
              "destination_namespace": "Target Namespace"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": {
        "footer": { "show": false },
        "sortBy": []
      }
    },
    {
      "title": "Sync History",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "{namespace=\"argocd\", container=\"argocd-application-controller\"} |= \"sync\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessages": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "title": "DORA Metrics",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "argocd_app_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "alias": "Deployment Frequency",
            "mode": "reduceRow",
            "reduceWith": "count",
            "fields": { "name": "name" }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Change Failure Rate",
            "mode": "reduceRow",
            "reduceWith": "count"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" }
        }
      },
      "options": {
        "footer": { "show": false }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "graphTooltip": 1
}
